ity')return 'جميل. كيف تشكر المضيف بعد تناول القهوة والتمر؟';if(scenario==='travel')return 'صف برنامج رحلتك مستخدمًا «أولًا، ثم، أخيرًا».';if(scenario==='dialect')return 'أحسنت! ما المقابل بالفصحى لهذه العبارة؟';return 'محاولة جيدة! حاول توسيع إجابتك إلى جملتين واستخدم «لأنّ» أو «ثم». يمكنك أن تسألني عن السوق أو الثقافة العُمانية.'}function selectCompanion(v){companion=v;store('companion',v);chatHistory=[];chat()}function selectScenario(v){scenario=v;chatHistory=[];chat()}function chat(){let c=characters[companion];app.innerHTML=`<h1>💬 مجلس المحادثة: سالم وسالمة</h1><p class="muted">اختر الشخصية والموقف، ثم تدرب كتابةً أو باستخدام الإملاء الصوتي إن كان متاحًا في متصفحك.</p><div class="character-grid"><button class="character ${companion==='salem'?'picked':''}" onclick="selectCompanion('salem')"><span class="face">👨🏽‍🏫</span><strong>سالم</strong><small>رفيقك اللغوي</small></button><button class="character ${companion==='salma'?'picked':''}" onclick="selectCompanion('salma')"><span class="face">👩🏽‍🏫</span><strong>سالمة</strong><small>رفيقتك اللغوية</small></button></div><div class="two"><div class="card"><h3>🎭 اختر موقفًا للمحادثة</h3><div class="scenario-grid">${Object.entries(scenarios).map(([k,v])=>`<button class="level ${scenario===k?'active':''}" onclick="selectScenario('${k}')">${v.name}</button>`).join('')}</div><div class="note">الشخصيتان في هذه النسخة تقدمان حوارًا مبرمجًا محليًا. الصوت يعتمد على دعم المتصفح، ولا يوجد اتصال بنموذج ذكاء اصطناعي توليدي حتى الآن.</div><h3>نصائح للمحادثة</h3><p class="muted">تحدث بجمل كاملة، واستخدم أدوات الربط، وأعد صياغة إجابتك إذا طلبت منك الشخصية ذلك.</p></div><div class="card"><h3>${c.icon} ${c.name} · ${scenarios[scenario].name}</h3><div class="chat" id="chatbox" aria-live="polite"><div class="bubble">${c.greeting} ${scenarios[scenario].prompt}</div>${chatHistory.map(m=>`<div class="bubble ${m.who==='me'?'me':''}">${escapeHTML(m.text)}</div>`).join('')}</div><div class="chatinput"><input id="msg" maxlength="600" aria-label=