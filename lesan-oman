</style></head><body><header><div class="top"><div class="brand">🇴🇲 لِسان عُمان <small>LISAN OMAN · Arabic & Culture</small></div><nav id="nav"></nav></div></header><main class="container" id="app"></main><footer class="foot">لِسان عُمان — تعلّم العربية، وعِش ثقافتها<br><small>نموذج أولي تفاعلي للمسابقة · تصميم وتجربة تعليمية قابلة للتطوير · @ismailalsheyadi</small></footer><script>
const pages=[['home','الرئيسية'],['test','تحديد المستوى'],['lessons','الدروس'],['games','الألعاب'],['chat','سالم وسالمة'],['culture','عُمان ولهجتها'],['progress','إنجازاتي']];let page='home',level='A1',qi=0,answers=[],chosen=null,gameScore=0,gameIndex=0,gameAnswered=false;const store=(k,v)=>localStorage.setItem('lisan_'+k,JSON.stringify(v)),load=(k,d)=>{try{return JSON.parse(localStorage.getItem('lisan_'+k))??d}catch{return d}};let points=load('points',0),completed=load('completed',[]);const app=document.getElementById('app');function go(p){page=p;render();scrollTo(0,0)}function award(n){points+=n;store('points',points)}function render(){document.getElementById('nav').innerHTML=pages.map(([id,name])=>`<button class="${page===id?'active':''}" onclick="go('${id}')">${name}</button>`).join('');({home,test,lessons,games,chat,culture,progress})[page]()}function card(emoji,title,desc,to){return `<div class="card"><div class="emoji">${emoji}</div><h3>${title}</h3><p>${desc}</p><button class="btn secondary" onclick="go('${to}')">ابدأ الآن ←</button></div>`}function home(){app.innerHTML=`<section class="hero"><div><span class="chip">من عُمان إلى العالم</span><h1>العربية أقرب إليك مما تتخيّل!</h1><p>رحلة تعليمية تفاعلية تبدأ بتحديد مستواك، ثم تتطور عبر الدروس والألعاب والمحادثة، وصولًا إلى اكتشاف عادات عُمان ولهجتها.</p><button class="btn" onclick="go('test')">اكتشف مستواك</button> <button class="btn secondary" onclick="go('lessons')">استكشف الدروس</button><div class="statrow" style="margin-top:22px"><span class="stat">6 مستويات</span><span class="stat">تحديات ممتعة</span><span class="stat">ثقافة عُمانية</span></div></div><div class="hero-art">📚<br>🧑🏽‍🏫 🇴🇲</div></section><h2 class="section-title">مسارات رحلتك</h2><div class="grid">${card('🎯','اختبار المستوى','أسئلة تشخيصية متدرجة مستوحاة من مستويات CEFR.','test')}${card('📖','أكاديمية العربية','دروس قصيرة وأمثلة وتمارين ذات تغذية راجعة.','lessons')}${card('🎮','مدينة الألعاب','تحديات مفردات وقواعد تجمع بين المتعة والجدية.','games')}${card('💬','سالم وسالمة','اختر رفيقك أو رفيقتك للتدرب على المحادثة ومواقف الحياة اليومية.','chat')}${card('🏺','عُمان تتحدث','الضيافة والملابس والمناسبات واللهجة العُمانية.','culture')}${card('🏅','إنجازاتي','تابع نقاطك والدروس التي أكملتها.','progress')}</div>`}
const qs=[['A1','اختر التحية المناسبة في الصباح.',['صباح الخير','تصبح على خير','إلى اللقاء'],0,'التحية الصباحية هي «صباح الخير».'],['A1','أنا ___ العربية كل يوم.',['يدرس','أدرس','تدرس'],1,'المتكلم المفرد يستخدم «أدرس».'],['A2','ذهب أحمد إلى السوق ___ اشترى فاكهة.',['ثم','لكن','لأن'],0,'«ثم» تدل على الترتيب.'],['A2','ما جمع كلمة «مدينة»؟',['مدائن فقط','مدن','مدينةات'],1,'الجمع الشائع: مُدُن.'],['B1','إذا درستَ بانتظام، ___ مستواك.',['يتحسّنُ','تحسّنَ','تتحسّنُ'],0,'جواب الشرط هنا فعل مضارع مناسب للفاعل.'],['B1','ما المعنى الأقرب لـ«على الرغم من»؟',['بسبب','مع أن','لذلك'],1,'تفيد الاستدراك أو المخالفة للتوقع.'],['B2','اختر التعبير الأفصح:',['لا بد أن نراعي اختلاف الثقافات','لا بد نراعي اختلاف الثقافات','لا بد مراعاة اختلاف الثقافات فقط'],0,'«لا بد أن» يليها فعل مضارع.'],['B2','في «لم يسعَ الطالبُ إلى الجائزة»، الفعل «يسعَ» هو:',['مرفوع','منصوب','مجزوم بحذف حرف العلة'],2,'جزم المضارع المعتل الآخر بحذف حرف العلة.'],['C1','ما وظيفة «غير أن» في النص الحجاجي؟',['الاستدراك','التعليل','التوكيد بالقسم'],0,'تربط بين فكرتين مع استدراك.'],['C1','أي الصيغ أدق؟',['ما كان الباحث ليهملَ هذه النتائج','ما كان الباحث ليهملُ هذه النتائج','ما كان الباحث ليهملْ هذه النتائج'],0,'الفعل منصوب بعد لام الجحود.'],['C2','في «ما أحسنَ الصدقَ!»، الأسلوب هو:',['استفهام','تعجب قياسي','نداء'],1,'صيغة التعجب «ما أفعلَه».'],['C2','«ليس كلُّ ما يُعرف يُقال» تفيد:',['نفي المعرفة كلها','وجوب قول كل معلوم','نفي الشمول لا شمول النفي'],2,'تنفي أن كل معلوم ينبغي قوله.']];function test(){qi=0;answers=[];chosen=null;testQuestion()}function testQuestion(){let q=qs[qi];app.innerHTML=`<div class="panel"><span class="chip">اختبار تشخيصي تجريبي · ${q[0]}</span><h2>اكتشف مستواك في العربية</h2><p class="muted">السؤال ${qi+1} من ${qs.length} · هذا الاختبار القصير يقيس جوانب محدودة من المفردات والقواعد، وليس شهادة CEFR معتمدة.</p><div class="progress"><div style="width:${qi/qs.length*100}%"></div></div><h3>${q[1]}</h3><div class="choices">${q[2].map((a,i)=>`<button class="choice ${chosen===i?'selected':''}" onclick="chosen=${i};testQuestion()">${a}</button>`).join('')}</div><button class="btn" ${chosen===null?'disabled':''} onclick="answers.push(chosen===qs[qi][3]);qi++;chosen=null;qi<qs.length?testQuestion():testResult()">${qi===qs.length-1?'عرض النتيجة':'السؤال التالي'}</button></div>`}function testResult(){let count=answers.filter(Boolean).length;let bands=['A1','A2','B1','B2','C1','C2'];let achieved=0;for(let i=0;i<6;i++){if(answers[i*2]&&answers[i*2+1])achieved=i+1;else break}let recommendation=bands[Math.min(achieved,5)];store('test',{count,recommendation,date:new Date().toLocaleDateString('ar-OM')});award(20);app.innerHTML=`<div class="panel" style="text-align:center"><div class="emoji">🏅</div><h2>أحسنت! اكتمل الاختبار</h2><div class="score">${count} / ${qs.length}</div><h3>المستوى المقترح للتعلّم: ${recommendation}</h3><p>الاقتراح مبني على اجتياز زوجي الأسئلة المتدرجين، وليس تحديدًا معياريًا رسميًا لمستواك في CEFR. يلزم تقييم الاستماع والقراءة والكتابة والتحدث للتحقق من المستوى.</p><button class="btn" onclick="level='${recommendation}';go('lessons')">ابدأ دروس ${recommendation}</button> <button class="btn outline" onclick="go('test')">أعد الاختبار</button></div>`}
const lessonData={A1:[['التحية والتعارف','مرحبًا! اسمي سالم. أنا من عُمان. ما اسمك؟','أكمل: ___ سالم.',['اسمي','اسمه','اسمك'],0],['في المدرسة','هذا كتابٌ. هذه حقيبةٌ. أنا طالبٌ.','اختر اسم الإشارة المناسب: ___ مدرسة.',['هذا','هذه','هؤلاء'],1]],A2:[['روتيني اليومي','أستيقظ صباحًا، ثم أتناول الإفطار وأذهب إلى العمل.','ما الكلمة التي تدل على الترتيب؟',['ثم','لكن','أو'],0],['زيارة السوق','اشتريتُ تمرًا وقهوةً من السوق أمس.','الفعل «اشتريتُ» يدل على:',['الماضي','المستقبل','الأمر'],0]],B1:[['التعبير عن الرأي','أعتقد أن تعلّم اللغات يفتح آفاقًا جديدة؛ لأنه يسهّل التواصل.','ما أداة التعليل؟',['لكن','لأن','ثم'],1],['رحلة إلى نزوى','إذا زرتَ نزوى، فستشاهد القلعة والسوق القديم.','الجملة تبدأ بأسلوب:',['شرط','نداء','قسم'],0]],B2:[['الحوار الثقافي','على الرغم من اختلاف العادات، فإن الاحترام المتبادل يعزز التفاهم.','«على الرغم من» تفيد:',['التعارض مع المتوقع','التعداد','الزمان'],0],['صياغة الحجة','من ناحية، توفر التقنية فرصًا؛ ومن ناحية أخرى، تثير تحديات.','وظيفة «من ناحية أخرى»:',['طرح وجه مقابل','إنهاء الكلام','السؤال'],0]],C1:[['اللغة والإقناع','لا تقتصر قيمة اللغة على التواصل، بل تتجاوز ذلك إلى تشكيل الهوية.','«بل» هنا تفيد:',['الانتقال والتصحيح','الشرط','التمني'],0],['الكتابة الأكاديمية','تشير النتائج إلى تحسن الأداء، غير أن تعميمها يستلزم الحذر.','«غير أن» تفيد:',['الاستدراك','السبب','التعجب'],0]],C2:[['البلاغة والتأويل','ليس كل ما يُقال يُراد به ظاهره؛ فالسياق مفتاح التأويل.','ما مفتاح التأويل في النص؟',['السياق','الوزن','القافية'],0],['الأساليب البلاغية','ما أجملَ العربيةَ حين تتسع للتعبير عن أدق المعاني!','ما الأسلوب البلاغي؟',['تعجب','نهي','استفهام'],0]]};function levels(){return `<div class="levels">${Object.keys(lessonData).map(l=>`<button class="level ${l===level?'active':''}" onclick="level='${l}';go('lessons')">${l}</button>`).join('')}</div>`}function lessons(){app.innerHTML=`<h1>📖 أكاديمية العربية</h1><p class="muted">اختر مستواك، ثم ابدأ درسًا مصغرًا وتحقق من فهمك.</p>${levels()}<div class="grid">${lessonData[level].map((d,i)=>`<div class="card"><span class="chi