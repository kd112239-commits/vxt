let journeyState=null,journeySelection=[],journeyIndex=0,journeyChoice=null;
const journeyStoreKey='treasureJourneyV1';
function journeySaved(){let x=load(journeyStoreKey,{stage:0,keys:[],stars:0});if(!x||!Number.isInteger(x.stage))return {stage:0,keys:[],stars:0};return {stage:Math.max(0,Math.min(3,x.stage)),keys:Array.isArray(x.keys)?x.keys:[],stars:Number(x.stars)||0}}
function journey(){let progress=journeySaved();app.innerHTML=profile()+`<div class="journey-banner"><div><span class="chip">مغامرة تفاعلية من ثلاث محطات</span><h1>🗝️ رحلة الكنز العُماني</h1><p>من أسواق مسقط إلى قلعة نزوى ثم خريف صلالة: أجب عن الألغاز، واجمع ثلاثة مفاتيح لفتح صندوق الكنز!</p></div><div style="font-size:70px">🧭🏆</div></div><div class="panel"><b>تقدم المغامرة: ${progress.keys.length} من 3 مفاتيح</b><div class="journey-meter"><div style="width:${progress.keys.length/3*100}%"></div></div><p>⭐ نجومك: ${progress.stars} · التحدي: 4 أسئلة مختلفة في كل محطة · تحتاج إلى 3 إجابات صحيحة للعبور.</p></div><div class="journey-map">${journeyPlaces.map((p,i)=>`<div class="journey-stop ${i===progress.stage?'current':''} ${i>progress.stage?'locked':''}"><div class="scene">${p.emoji}</div><h3>${i+1}. ${p.name}</h3><p>${p.desc}</p><span class="ribbon">${progress.keys.includes(i)?'🔑 '+p.prize:i>progress.stage?'🔒 افتح المحطة السابقة':'🧩 '+p.title}</span><p><button class="btn ${i>progress.stage?'secondary':''}" ${i>progress.stage?'disabled':''} onclick="journeyStart(${i})">${progress.keys.includes(i)?'أعد المغامرة':i===progress.stage?'ابدأ التحدي':'مغلقة'}</button></p></div>`).join('')}</div><div id="journeyPlay"></div>${progress.stage>=3?'<div class="panel" style="text-align:center"><div class="journey-treasure">🏆💎🎁</div><h2>مبارك! اكتشفت كنز عُمان!</h2><p>الكنز الحقيقي هو العربية ومعرفة الثقافة العُمانية.</p><button class="btn" onclick="journeyReset()">ابدأ رحلة جديدة</button></div>':''}`}
function journeyStart(stage){let progress=journeySaved();if(stage>progress.stage)return;journeyState={stage,correct:0,answered:0};journeySelection=[...journeyPlaces[stage].questions].sort(()=>Math.random()-.5).slice(0,4).map(q=>{let choices=q[1].map((t,i)=>({t,correct:i===q[2]}));for(let i=choices.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[choices[i],choices[j]]=[choices[j],choices[i]]}return {prompt:q[0],choices,why:q[3]}});journeyIndex=0;journeyChoice=null;journeyDraw();document.getElementById('journeyPlay')?.scrollIntoView({behavior:'smooth',block:'center'})}
function journeyDraw(){let area=document.getElementById('journeyPlay');if(!area||!journeyState)return;let stage=journeyState.stage,q=journeySelection[journeyIndex];if(!q){journeyFinish();return}area.innerHTML=`<div class="journey-challenge"><span class="chip">${journeyPlaces[stage].name} · اللغز ${journeyIndex+1} من 4</span><h2>${journeyPlaces[stage].title}</h2><div class="journey-meter"><div style="width:${journeyIndex/4*100}%"></div></div><h3>${q.prompt}</h3><div class="journey-answers">${q.choices.map((o,i)=>`<button id="journeyAnswer${i}" onclick="journeyAnswer(${i})">${safe(o.t)}</button>`).join('')}</div><div id="journeyFeedback" aria-live="polite"></div></div>`}
function journeyAnswer(i){if(journeyChoice!==null)return;journeyChoice=i;let q=journeySelection[journeyIndex],right=q.choices[i].correct;if(right)journeyState.correct++;journeyState.answered++;q.choices.forEach((o,j)=>{let b=document.getElementById('journeyAnswer'+j);if(!b)return;b.disabled=true;if(o.correct)b.classList.add('correct');else if(j===i)b.classList.add('wrong')});document.getElementById('journeyFeedback').innerHTML=`<div class="journey-feedback"><b>${right?'🌟 إجابة صحيحة!':'💡 حاول تذكّر المعلومة في المرة القادمة.'}</b><p>${safe(q.why)}</p><button class="btn" onclick="journeyNext()">${journeyIndex===3?'اعرض نتيجة المحطة':'اللغز التالي ←'}</button></div>`}
function journeyNext(){journeyIndex++;journeyChoice=null;journeyDraw()}
function journeyFinish(){let p=journeySaved(),stage=journeyState.stage,passed=journeyState.correct>=3;let earned=journeyState.correct*5;if(passed&&!p.keys.includes(stage)){p.keys.push(stage);p.stage=Math.max(p.stage,stage+1);p.stars+=earned;store(journeyStoreKey,p);award(earned)}let area=document.getElementById('journeyPlay');if(!area)return;area.innerHTML=`<div class="journey-challenge" style="text-align:center"><div class="journey-treasure">${passed?'🔑✨':'🧩📜'}</div><h2>${passed?'أحسنت! حصلت على '+journeyPlaces[stage].prize:'لم يفتح الصندوق بعد'}</h2><p>أجبت إجابة صحيحة عن ${journeyState.correct} من 4 ألغاز.</p><p>${passed?'انتقلت إلى المحطة التالية.':'تحتاج إلى 3 إجابات صحيحة على الأقل. حاول مجددًا بأسئلة متنوعة.'}</p><button class="btn" onclick="journey()">${passed?'العودة إلى خريطة الرحلة':'أعد المحاولة'}</button></div>`;}
function journeyReset(){store(journeyStoreKey,{stage:0,keys:[],stars:0});journey()}
pages.splice(pages.findIndex(x=>x[0]==='progress'),0,['journey','🗝️ رحلة الكنز']);
