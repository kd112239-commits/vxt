function drawGame(){let g=gameState,area=document.getElementById('playArea');if(!area)return;let idx=g.step%gameDeck.length,word=gameDeck[idx];if(g.finished){area.innerHTML=`<div class="panel"><h2>🏆 انتهت الجولة!</h2><p class="score">${g.score} نقطة</p><button class="btn" onclick="startGame('${gameType}')">إعادة اللعب</button></div>`;return}let top=`<div class="panel"><h2>${{uno:'🃏 أونو المفردات',snake:'🐍 الثعبان والسلم',football:'⚽ كرة القدم اللغوية'}[gameType]}</h2><span class="chip">الجولة ${g.step+1}</span><p>ما التصنيف الصحيح للكلمة: <strong>${word[0]}</strong>؟</p>`;let opts=[word[1],...['مهنة','مدينة','لون','تحية','عائلة','قيمة','ملابس','مكان','فعل','طعام','ضيافة'].filter(x=>x!==word[1]).slice((idx*2)%6,(idx*2)%6+2)];if(opts.length<3)opts=[word[1],'مكان','فعل'];opts.sort((a,b)=>a.localeCompare(b));if(gameType==='uno')top+=`<div class="uno-hand">${opts.map((o,i)=>`<button class="uno-card ${['red','blue','green'][i]}" onclick='gameMove(${JSON.stringify(o)})'><span>UNO</span>${o}<span>✦</span></button>`).join('')}</div>`;if(gameType==='snake'){let cells=Array.from({length:25},(_,i)=>25-i);top+=`<div class="gameboard">${cells.map(n=>`<div class="square ${g.pos===n?'player':''}">${n}${n===g.pos?' 🧍':''}${[4,12,19].includes(n)?' 🪜':''}${[9,17,23].includes(n)?' 🐍':''}</div>`).join('')}</div><p>الموقع الحالي: ${g.pos} · الإجابة الصحيحة ترمي النرد</p>`}if(gameType==='football')top+=`<div class="pitch"><h2>🥅 المرمى</h2><div style="font-size:36px">${'⚽ '.repeat(Math.max(1,5-g.step))}</div><p>كل إجابة صحيحة = هدف!</p></div>`;if(gameType!=='uno')top+=`<div class="choices">${opts.map(o=>`<button class="choice" onclick='gameMove(${JSON.stringify(o)})'>${o}</button>`).join('')}</div>`;area.innerHTML=top+`<p id="gameMsg" role="status"></p></div>`}
