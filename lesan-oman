@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap');:root{--navy:#12344a;--teal:#087d80;--mint:#dff6ed;--sand:#fff6e8;--gold:#e7a83e;--ink:#203645;--muted:#637784}*{box-sizing:border-box}body{margin:0;font-family:Cairo,Tahoma,sans-serif;background:#f4f8f7;color:var(--ink)}button,input,select{font:inherit}button{cursor:pointer}header{background:#fff;box-shadow:0 2px 18px #15384a12;position:sticky;top:0;z-index:10}.top{max-width:1200px;margin:auto;padding:12px 20px;display:flex;align-items:center;gap:18px;justify-content:space-between;flex-wrap:wrap}.brand{font-size:24px;font-weight:800;color:var(--teal)}.brand small{display:block;font-size:10px;color:#72858b;line-height:1.1}nav{display:flex;gap:5px;flex-wrap:wrap}nav button{border:0;background:transparent;padding:9px 12px;border-radius:12px;color:var(--navy);font-weight:700}nav button.active,nav button:hover{background:var(--mint);color:var(--teal)}.container{max-width:1200px;margin:auto;padding:25px 20px 55px}.hero{background:linear-gradient(115deg,#0d6870,#12374f);border-radius:28px;color:#fff;padding:40px;display:grid;grid-template-columns:1.4fr .8fr;gap:25px;align-items:center;overflow:hidden}.hero h1{font-size:clamp(28px,4vw,48px);margin:0 0 12px}.hero p{font-size:17px;line-height:2;opacity:.94}.hero-art{font-size:100px;text-align:center;background:#ffffff13;border:1px solid #ffffff30;border-radius:25px;padding:20px}.btn{border:0;border-radius:12px;padding:11px 20px;font-weight:800;background:var(--gold);color:#26333b}.btn.secondary{background:#e2f5f1;color:#126c70}.btn.outline{background:white;border:1px solid #bddbd9;color:var(--teal)}.btn:disabled{opacity:.5;cursor:not-allowed}.section-title{margin:30px 0 16px;font-size:24px;color:var(--navy)}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.card{background:white;border:1px solid #e0ebeb;border-radius:20px;padding:22px;box-shadow:0 8px 30px #1b5b6a0a}.card h3{margin:5px 0 8px;color:var(--navy)}.card p